    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.39.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "tsx": "^4.23.15",
