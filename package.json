    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "yauzl": "^3.4.0"
