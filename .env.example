APP_NAME="Event Photos"
APP_URL=http://localhost:3000
# At least 32 characters. Generate one with: openssl rand -base64 32
APP_SECRET=change-me-change-me-change-me-change-me
DATABASE_URL=postgres://localhost/event_photos_dev

# disk (development only) or s3
STORAGE_DRIVER=disk
STORAGE_DIR=.data/storage
#S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# Email. Printed to the console when SMTP_URL is empty (development only).
#SMTP_URL=smtp://user:pass@host:587
MAIL_FROM="Event Photos <noreply@example.test>"

# Optional Google sign-in
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# How many reverse proxies sit in front of the app
TRUSTED_PROXY_HOPS=0
REPORT_EMAIL=report@example.test
